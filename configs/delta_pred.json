{
  "artifacts_dir": "artifacts/delta_pred",
  "codec": {
    "kind": "jepa",
    "device": "auto",
    "jepa_checkpoint": "artifacts/jepa_v3_128t/jepa/joint_robust.pt"
  },
  "data": {
    "corpus_path": "data/corpus_1m.txt",
    "context_len": 16,
    "min_sentence_chars": 12,
    "max_sentence_chars": 400
  },
  "predictor": {
    "d_model": 256,
    "n_layers": 6,
    "n_heads": 8,
    "ff_mult": 4,
    "max_seq_len": 64,
    "dropout": 0.1,
    "head": "regression",
    "cosine_weight": 1.0,
    "mse_weight": 0.0,
    "use_segment_embedding": false,
    "use_theme": false
  },
  "train": {
    "batch_size": 256,
    "lr": 0.0003,
    "weight_decay": 0.01,
    "epochs": 20,
    "val_fraction": 0.05,
    "warmup_steps": 200,
    "grad_clip": 1.0,
    "seed": 0
  },
  "gpu_gate": {
    "enabled": true,
    "foreign_util_pct": 40.0,
    "resume_util_pct": 20.0
  }
}
