{
  "backbone": "Qwen/Qwen3-1.7B-Base",
  "backbone_fallback": "allenai/OLMo-2-0425-1B",
  "load_in_4bit": true,
  "bnb_4bit_quant_type": "nf4",
  "bnb_4bit_compute_dtype": "bfloat16",
  "bnb_4bit_use_double_quant": true,
  "z_dim": 512,
  "d_model": 2048,
  "n_prefix": 16,
  "adapter_hidden": 512,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "lr_adapter": 5e-4,
  "lr_lora": 1e-4,
  "weight_decay": 0.01,
  "micro_batch": 1,
  "grad_accum": 64,
  "effective_batch": 64,
  "ctx_max": 512,
  "max_prev_tokens": 256,
  "max_target_tokens": 256,
  "kappa_aug": 500.0,
  "prefix_drop_p": 0.10,
  "epochs": 2,
  "min_paragraphs": 150000,
  "seed": 42,
  "grad_clip": 1.0,
  "eval_every_steps": 500,
  "eval_n": 64,
  "log_every": 1,
  "ckpt_every_steps": 50,
  "pretokenize": true,
  "num_workers": 0,
  "micro_log_every": 0,
  "corpus": "data/corpus_v2.txt",
  "zbank": "artifacts/corpus_v2/zbank.npz",
  "jepa": "artifacts/jepa_repair_1m/jepa/joint.pt",
  "out_dir": "artifacts/pivot_stageA",
  "db_path": "artifacts/pivot_stageA/checkpoints.sqlite",
  "gpu_gate": true,
  "pytorch_cuda_alloc_conf": "expandable_segments:True"
}
