{
  "artifacts_dir": "artifacts/jepa_v3_128t",
  "codec": {
    "kind": "jepa",
    "device": "auto",
    "jepa_checkpoint": "artifacts/jepa_v3_128t/jepa/joint_robust.pt"
  },
  "data": {
    "corpus_path": "data/corpus_1m.txt",
    "context_len": 32
  },
  "predictor": {
    "head": "diffusion",
    "d_model": 512,
    "n_layers": 8,
    "n_heads": 8,
    "max_seq_len": 64,
    "dropout": 0.1,
    "diffusion": {
      "num_train_timesteps": 200,
      "beta_start": 0.0001,
      "beta_end": 0.02,
      "predict_type": "epsilon",
      "sampler": "ddim",
      "sampling_steps": 30,
      "head_hidden": 1024,
      "head_layers": 4,
      "time_dim": 128,
      "sample_jitter": 0.0,
      "cfg_drop_prob": 0.1,
      "cfg_scale": 3.0,
      "use_film": true
    }
  },
  "train": {
    "batch_size": 8,
    "lr": 0.0001,
    "weight_decay": 0.01,
    "epochs": 5,
    "warmup_steps": 50,
    "grad_clip": 1.0,
    "val_fraction": 0.05,
    "seed": 42
  },
  "eval": {
    "eval_path": "data/eval",
    "rollout_steps": 6,
    "output_dir": "eval_hybrid",
    "compute_latent_diagnostics": true
  },
  "gpu_gate": {
    "enabled": true,
    "foreign_util_pct": 40.0,
    "resume_util_pct": 20.0
  },
  "jepa": {
    "dim": 512,
    "tokenizer": "gpt2",
    "max_tokens": 128,
    "context_len": 32
  },
  "writer": {
    "dim": 768,
    "n_layers": 12,
    "n_heads": 12,
    "ff_mult": 4,
    "seq_len": 256,
    "batch_size": 8,
    "lr": 3e-4,
    "lr2": 1e-4,
    "epochs": 8,
    "steps_per_epoch": 2000,
    "gradient_acc": 8,
    "phase1_checkpoint": "artifacts/writer_p1/writer_p1.pt",
    "jepa_checkpoint": "artifacts/jepa_v3_128t/jepa/joint_robust.pt",
    "db_path": "artifacts/writer_p2/train.db",
    "run_id": 0,
    "use_concept": true,
    "seed": 42
  },
  "decoder_robust": {
    "epochs": 6,
    "batch_size": 8,
    "lr": 0.0001,
    "perturb_sigma": 0.12,
    "scheduled_sampling_start": 0.0,
    "scheduled_sampling_end": 0.6,
    "sampling_steps": 15
  }
}
