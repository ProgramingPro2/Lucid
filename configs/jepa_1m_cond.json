{
  "artifacts_dir": "artifacts/jepa_1m_cond",
  "codec": {
    "kind": "jepa",
    "device": "auto",
    "jepa_checkpoint": "artifacts/jepa_1m_unif/jepa/joint.pt"
  },
  "data": {
    "corpus_path": "data/corpus_1m.txt",
    "context_len": 8
  },
  "predictor": {
    "d_model": 512,
    "n_layers": 6,
    "n_heads": 8,
    "max_seq_len": 64,
    "dropout": 0.1,
    "use_segment_embedding": true,
    "use_theme": true
  },
  "train": {
    "batch_size": 64,
    "lr": 3e-4,
    "weight_decay": 0.01,
    "epochs": 15,
    "warmup_steps": 100,
    "grad_clip": 1.0,
    "val_fraction": 0.05,
    "seed": 0
  },
  "instruction": {
    "source": "both",
    "cache_path": "instructions/pairs.npz",
    "hf_dataset": "databricks/databricks-dolly-15k",
    "hf_split": "train",
    "max_pairs": 3000,
    "instruction_field": "instruction",
    "response_field": "response",
    "templates": [
      "Write a passage about {theme}.",
      "Describe {theme}.",
      "Tell me about {theme}."
    ],
    "themes": [
      "history",
      "science",
      "music",
      "nature",
      "the sea",
      "a city",
      "war",
      "medicine",
      "education",
      "sports"
    ],
    "max_response_sentences": 6,
    "max_instruction_sentences": 3,
    "author_with_llm": false
  },
  "gpu_gate": {
    "enabled": true,
    "foreign_util_pct": 65.0,
    "resume_util_pct": 40.0
  }
}
