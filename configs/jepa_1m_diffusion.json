{
  "artifacts_dir": "artifacts/jepa_1m_diffusion",
  "codec": {
    "kind": "jepa",
    "device": "auto",
    "jepa_checkpoint": "artifacts/jepa_1m_unif/jepa/joint.pt"
  },
  "data": {
    "corpus_path": "data/corpus_1m.txt",
    "context_len": 8
  },
  "predictor": {
    "head": "diffusion",
    "d_model": 512,
    "n_layers": 6,
    "n_heads": 8,
    "max_seq_len": 64,
    "dropout": 0.1,
    "diffusion": {
      "num_train_timesteps": 100,
      "beta_start": 0.0001,
      "beta_end": 0.02,
      "predict_type": "epsilon",
      "sampler": "ddim",
      "sampling_steps": 30,
      "head_hidden": 1024,
      "head_layers": 3,
      "time_dim": 128,
      "sample_jitter": 0.0
    }
  },
  "train": {
    "batch_size": 32,
    "lr": 0.0003,
    "weight_decay": 0.01,
    "epochs": 12,
    "warmup_steps": 100,
    "grad_clip": 1.0,
    "val_fraction": 0.05,
    "seed": 0
  },
  "eval": {
    "eval_path": "data/eval",
    "rollout_steps": 6,
    "output_dir": "eval_diffusion",
    "compute_latent_diagnostics": true
  },
  "gpu_gate": {
    "enabled": true,
    "foreign_util_pct": 65.0,
    "resume_util_pct": 40.0
  },
  "jepa": {
    "dim": 512,
    "tokenizer": "gpt2",
    "max_tokens": 48,
    "context_len": 8
  },
  "decoder_robust": {
    "epochs": 3,
    "batch_size": 16,
    "lr": 0.0001,
    "perturb_sigma": 0.08,
    "scheduled_sampling_end": 0.5,
    "sampling_steps": 20
  }
}
