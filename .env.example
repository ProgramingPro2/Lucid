# Copy to .env and fill in. All values are optional unless noted.

# Judge backend: heuristic | lemonade | openai
# Default is heuristic (offline, no LLM required).
JUDGE_BACKEND=heuristic

# Lemonade local judge (requires Lemonade Server running and JUDGE_BACKEND=lemonade)
LEMONADE_BASE_URL=http://localhost:13305/api/v1
LEMONADE_API_KEY=lemonade
LEMONADE_JUDGE_MODEL=user.Flow-Judge-v0.1-GGUF-Q4_K_M

# OpenAI cloud judge (requires OPENAI_API_KEY and JUDGE_BACKEND=openai)
OPENAI_API_KEY=
OPENAI_JUDGE_MODEL=gpt-4o-mini

# Shared secret raters type in to attribute their ratings (optional).
RATING_APP_SECRET=
