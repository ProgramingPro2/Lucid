# Copy to .env and fill in. All values are optional.

# Enables the OpenAI-backed LLM-as-judge and LLM quality-control passes.
# If unset, a deterministic heuristic judge is used so the pipeline runs offline.
OPENAI_API_KEY=
OPENAI_JUDGE_MODEL=gpt-4o-mini

# Shared secret raters type in to attribute their ratings (optional).
RATING_APP_SECRET=
